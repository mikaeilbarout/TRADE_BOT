# Copy to .env and fill in your own values. Never commit the real .env.

# MetaTrader 5 account
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# AI review service (optional)
AI_REVIEW_ENABLED=true
AI_REVIEW_URL=http://your-ai-server:8000/api/v1/trade-signal
AI_REVIEW_TIMEOUT_SECONDS=60
AI_REVIEW_API_KEY=your_ai_api_key

# Optional: pin the broker server clock offset instead of detecting it
# MT5_SERVER_UTC_OFFSET_HOURS=3

# Unused by the Donchian bot; kept for compatibility
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
