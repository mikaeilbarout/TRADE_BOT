# Copy to .env and fill in real values. .env is gitignored.

# --- Trading mode: paper | shadow | live | manual --------------------------
TRADING_MODE=paper

# --- LLM ---------------------------------------------------------------
# anthropic | openai | mock  (mock = no network calls, deterministic canned
# responses only -- for local dev/tests, never for live trading)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_TIMEOUT_SECONDS=10
# Retries per agent on a transient LLM failure (timeout/rate limit/malformed
# output) before failing closed.
LLM_MAX_RETRIES=1

# --- News --------------------------------------------------------------
# finnhub | fred | finnhub+fred | newsapi | mock
# finnhub.io free tier has no publish-time embargo (unlike the newsapi.org
# free plan, which refuses anything published in the last ~24h -- that made
# NEWS_LOOKBACK_MINUTES windows resolve empty on every single call). Even
# with finnhub, a genuinely fresh gold/macro item typically only appears
# every few hours, so 180 (not 60) actually returns items most of the time
# -- news_agent's own prompt already weighs each item's age_minutes.
# fred = actual macro releases (CPI, NFP, Fed funds, ...) from FRED, free
# key at fredaccount.stlouisfed.org/apikeys -- covers content Finnhub's
# generic business-news feed rarely does. finnhub+fred merges both (see
# app/providers/news/composite_provider.py), recommended over either alone.
NEWS_PROVIDER=mock
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
# 180->720: FRED releases follow a real publish calendar, not a continuous
# stream -- confirmed live, a 180min window caught 0 of the last 24h's 5
# real releases, 720min caught most of them. news_agent's own prompt
# already discounts older items by age_minutes, so widening is safe.
NEWS_LOOKBACK_MINUTES=720
NEWS_CACHE_TTL_SECONDS=120
# Oldest cached news bundle still usable when the provider is down; past
# this the pipeline fails closed instead of deciding on stale headlines.
NEWS_MAX_FALLBACK_AGE_SECONDS=900
HIGH_IMPACT_NEWS_BLACKOUT_MINUTES=15

# --- Sentiment ---------------------------------------------------------
# mock | newsapi | finnhub (heuristic score over real headlines, needs
# NEWSAPI_API_KEY or FINNHUB_API_KEY above -- see
# app/providers/sentiment/newsapi_sentiment_provider.py /
# finnhub_sentiment_provider.py. Not a dedicated positioning/social vendor;
# implement SentimentProvider for one.)
SENTIMENT_PROVIDER=mock
SENTIMENT_LOOKBACK_MINUTES=180
SENTIMENT_CACHE_TTL_SECONDS=120
# Oldest cached sentiment bundle still usable when the provider is down
# (mirrors NEWS_MAX_FALLBACK_AGE_SECONDS); past this the pipeline fails
# closed instead of deciding on a stale sentiment picture.
SENTIMENT_MAX_FALLBACK_AGE_SECONDS=900

# --- Market data ---------------------------------------------------------
# mock | yahoo | oanda
# yahoo: free, keyless chart API -- real but unofficial, no bid/ask, quotes
#   commonly minutes stale. See app/providers/market_data/yahoo_provider.py.
# oanda: free OANDA v20 account (practice or live), real bid/ask, quotes
#   typically tens of seconds stale. Needs OANDA_API_KEY + OANDA_ACCOUNT_ID
#   below. See app/providers/market_data/oanda_provider.py.
# Implement MarketDataProvider against a broker/MT5/ccxt/vendor feed and
# register it in app/providers/factory.py for anything else.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_MAX_STALENESS_SECONDS=30
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Risk limits ---------------------------------------------------------
MAX_RISK_PER_TRADE_PCT=0.5
# Monetary risk cannot be computed without the account balance, so signals
# that omit it are rejected rather than skipping the limit. Set false only if
# your bot owns sizing and you accept the limit is unenforceable here.
REQUIRE_ACCOUNT_BALANCE=true
MAX_DAILY_LOSS_PCT=2.0
MAX_TRADES_PER_DAY=20
MAX_SIMULTANEOUS_POSITIONS=5
MAX_EXPOSURE_PER_ASSET_PCT=5.0
MAX_LEVERAGE=20
MAX_STOP_LOSS_DISTANCE_PCT=3.0
MIN_RISK_REWARD_RATIO=1.0
MAX_SPREAD_PCT=0.15
# Market orders: how far price may drift from the intended entry.
MAX_SLIPPAGE_PCT=0.1
# Pending/limit entries (e.g. an agent's pullback entry): how far the resting
# order may sit from the live price.
MAX_PENDING_ENTRY_DISTANCE_PCT=1.0
# ATR must not exceed this multiple of the trade's stop distance.
MAX_VOLATILITY_ATR_MULTIPLE=4.0
MAX_SIGNAL_AGE_SECONDS=120

# --- Decision thresholds --------------------------------------------------
# Matches configs/m15_looser.json -- the policy actually backtested and
# validated (pilot_v16_veto_fix: net +$4,836 vs baseline +$2,166 on the same
# 190-signal out-of-sample set). Change deliberately, not by reverting to
# untested defaults.
MIN_CONFIDENCE=0.55
MIN_WEIGHTED_SCORE=50
SHORT_CIRCUIT_ON_CRITICAL_NEWS=true
# All off by default: a single specialist's BLOCK used to force-reject a
# trade regardless of what final_decision_agent itself concluded, even when
# the other two dimensions strongly supported it -- making final_agent's own
# synthesis pointless in exactly the case it exists to handle. Set any of
# these true to restore the old "one BLOCK always wins" behavior for that
# dimension. Deterministic backstops (MIN_CONFIDENCE, MIN_WEIGHTED_SCORE,
# the news blackout, hard account/risk limits) apply regardless.
VETO_ON_NEWS_BLOCK=false
VETO_ON_SENTIMENT_BLOCK=false
VETO_ON_TECHNICAL_BLOCK=false

# --- Scoring weights (must sum to 1.0) -----------------------------------
WEIGHT_NEWS=0.25
WEIGHT_SENTIMENT=0.10
WEIGHT_TECHNICAL=0.45
WEIGHT_RISK=0.20

# --- Timeframes (comma-free JSON arrays) ---------------------------------
DEFAULT_HIGHER_TIMEFRAMES=["D1","H4"]
DEFAULT_MEDIUM_TIMEFRAMES=["H1","M30"]
DEFAULT_ENTRY_TIMEFRAMES=["M15","M5"]

# --- Persistence -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trade_agent:trade_agent@localhost:5432/trade_agent
# Optional. When set, news/sentiment caches are shared across API workers;
# any Redis failure degrades to the in-process cache.
REDIS_URL=redis://localhost:6379/0

# --- API ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# When set, callers must send it as the X-API-Key header (/health stays open).
INTERNAL_API_KEY=

# =====================================================================
# AI backtest layer (research/ai) -- cost-controlled experiment
# =====================================================================
AI_ENABLED=true

# Model routing: cheap analysts, capable adjudicator. Never hard-coded in
# code -- every agent's model is read from these vars.
AI_TECHNICAL_MODEL=claude-haiku-4-5
AI_NEWS_MODEL=claude-haiku-4-5
AI_SENTIMENT_MODEL=claude-haiku-4-5
AI_FINAL_MODEL=claude-sonnet-5

# Hard spend cap. The run stops safely when reached; spend recovered from
# the checkpoint counts against it, so a restart cannot double the budget.
AI_COST_LIMIT_USD=10
AI_MAX_SIGNALS_PER_RUN=100

# Batch API runs asynchronously at 50% of standard rates -- correct for a
# historical backtest, never for live trading.
AI_USE_BATCH=true
AI_USE_PROMPT_CACHE=true
AI_CACHE_TTL=1h
# Outputs are reason codes, not prose. Keep this small.
AI_MAX_OUTPUT_TOKENS=400

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_CONCURRENCY=4

# Context sizing -- fewer tokens per call means lower cost per signal.
AI_TECHNICAL_LOOKBACK_BARS=60
AI_HTF_LOOKBACK_BARS=30
AI_NEWS_MAX_ITEMS=8
AI_SENTIMENT_MAX_ITEMS=6

# Fail-closed policy: missing/invalid information never becomes approval.
AI_FAIL_CLOSED_POLICY=NO_TRADE
# Skip an agent whose point-in-time store has nothing for that timestamp --
# it could only answer UNAVAILABLE, so the call would be pure waste.
AI_SKIP_AGENT_WHEN_DATA_UNAVAILABLE=true
AI_ALLOW_MODIFY=true

# --- Deterministic policy (shared with the live service) ------------------
# These mirror MIN_CONFIDENCE / MIN_WEIGHTED_SCORE / VETO_ON_* / WEIGHT_* above
# and are applied by the SAME code (app/services/policy_core.py) in both the
# live path and the backtest. In a real experiment they are set once in the
# experiment config, which overrides both sides -- see docs/METHODOLOGY.md.
AI_MIN_FINAL_CONFIDENCE=0.55
AI_MIN_WEIGHTED_SCORE=50
AI_VETO_ON_NEWS_BLOCK=true
AI_VETO_ON_SENTIMENT_BLOCK=false
AI_VETO_ON_TECHNICAL_BLOCK=true
AI_WEIGHT_NEWS=0.25
AI_WEIGHT_SENTIMENT=0.10
AI_WEIGHT_TECHNICAL=0.45
AI_WEIGHT_RISK=0.20

# Planned placebo control, NOT part of the pilot. Strips absolute dates from
# agent payloads so a future control arm can measure how much of the AI layer's
# edge comes from recognising the period rather than reading the setup. See the
# MODEL_KNOWLEDGE_LEAKAGE limitation in docs/METHODOLOGY.md.
AI_STRIP_DATES=false

AI_CHECKPOINT_PATH=results/ai_checkpoint.sqlite
AI_RESULTS_DIR=results/ai

# =====================================================================
# Automated historical data ingestion (python -m research_data)
# =====================================================================

# --- Economic calendar: FRED / ALFRED ------------------------------------
# FREE. Register at https://fredaccount.stlouisfed.org/apikeys -- no cost, no
# card, issued immediately. Raises the rate limit from 30 to 120 requests/min.
# This is the ONLY credential the ingestion pipeline needs; GDELT requires none.
FRED_API_KEY=

# --- Hosts that must be reachable ---------------------------------------
# The pipeline fetches from exactly two hosts. In a network-restricted
# environment both must be allowed in the egress policy, or ingestion reports
# the denial and stops rather than producing an empty dataset:
#   data.gdeltproject.org   (news + point-in-time tone, no key)
#   api.stlouisfed.org      (economic calendar vintages, needs the key above)

# --- Calendar release-time policy ----------------------------------------
# ALFRED records the release DATE, not the clock time.
#   END_OF_DAY       (default, leakage-safe) a release becomes visible at
#                    23:59:59 UTC on its release date. Never early.
#   SCHEDULED_LOCAL  the publisher's usual clock time (e.g. 08:30 New York),
#                    converted to UTC with DST handled, and labelled
#                    IMPUTED_FROM_SCHEDULE because it is an assumption.
INGEST_RELEASE_TIME_POLICY=END_OF_DAY

# --- Retrospective sentiment (OFF by default) ---------------------------
# Scoring archived headlines with a model running today is NOT point-in-time
# data. Such records are labelled RETROSPECTIVE, written to a separate file, and
# refused by the leakage-safe experiment. Enable only for diagnostic comparison.
INGEST_RETROSPECTIVE_SENTIMENT=false
INGEST_RETROSPECTIVE_MODEL=claude-haiku-4-5
